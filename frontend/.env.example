# 카카오맵 JavaScript SDK 키
# https://developers.kakao.com/console/app 에서 발급받은 뒤,
# 이 파일을 .env로 복사하고 아래 값을 채워 넣으세요.
# (플랫폼 설정에 http://localhost:5173 및 배포 도메인을 등록해야 합니다)
VITE_KAKAO_MAP_KEY=

# 배포된 백엔드 API 주소 (로컬 개발 중엔 비워두면 vite proxy를 그대로 씀)
# 예: https://r2d-backend.onrender.com/api/v1
VITE_API_BASE_URL=

# VWorld 3D 지도 API 인증키
# https://www.vworld.kr 가입 → 마이포털 > 나의 오픈API > 인증키 관리 > 발급하기
# (사용할 도메인을 등록해야 합니다 — 로컬은 http://localhost:5173)
VITE_VWORLD_MAP_KEY=
